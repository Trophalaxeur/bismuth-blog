{
	"name": "bismuth-blog",
	"type": "module",
	"version": "0.0.1",
	"packageManager": "npm@10.9.0",
	"scripts": {
		"dev": "astro check --watch & astro dev",
		"start": "astro dev",
		"build": "astro check && astro build",
		"preview": "astro preview",
		"astro": "astro",
		"lint": "npm run lint:prettier && npm run lint:eslint && npm run lint:stylelint",
		"lint:prettier": "prettier --check \"**/*.{js,ts,tsx,astro,css}\"",
		"lint:eslint": "eslint \"src/**/*.{js,ts,tsx,astro}\"",
		"lint:stylelint": "stylelint \"src/**/*.css\"",
		"test": "vitest run",
		"og:preview": "node --experimental-strip-types --no-warnings scripts/og-preview.ts",
		"cv:pdf": "npm run build && node --experimental-strip-types --no-warnings scripts/generate-cv-pdf.ts"
	},
	"dependencies": {
		"@astrojs/mdx": "^5.0.4",
		"@astrojs/rss": "^4.0.18",
		"@astrojs/sitemap": "^3.7.2",
		"@astrojs/starlight": "^0.39.3",
		"@astrojs/starlight-tailwind": "^5.0.0",
		"@resvg/resvg-js": "^2.6.2",
		"@tailwindcss/vite": "^4.3.0",
		"astro": "^6.3.1",
		"astro-d2": "0.11.0",
		"astro-expressive-code": "^0.42.0",
		"clsx": "^2.1.1",
		"js-yaml": "^4.2.0",
		"mdast-util-to-string": "^4.0.0",
		"reading-time": "^1.5.0",
		"rehype-external-links": "^3.0.0",
		"rehype-slug": "6.0.0",
		"rehype-stringify": "^10.0.1",
		"rehype-unwrap-images": "^1.0.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"satori": "^0.26.0",
		"sharp": "^0.34.5",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"unified": "^11.0.5"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@tailwindcss/typography": "^0.5.19",
		"eslint": "^10.3.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-astro": "^1.7.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-unused-imports": "^4.4.1",
		"prettier": "^3.8.3",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"stylelint": "^17.11.0",
		"stylelint-config-standard": "^40.0.0",
		"stylelint-config-tailwindcss": "^1.0.1",
		"stylelint-order": "^8.1.1",
		"stylelint-scss": "^7.0.0",
		"typescript-eslint": "^8.59.2",
		"vitest": "^4.1.8"
	}
}
