---
import BaseHead from '@/components/BaseHead.astro';
import { siteConfig } from '@/site-config';

interface Props {
  title?: string;
}
const { title = 'CV — Florian Lefevre' } = Astro.props;
---

<html lang={siteConfig.lang}>
  <head>
    <BaseHead title={title} description="Curriculum Vitae de Florian Lefevre" />
    <style>
      @media print {
        @page {
          size: A4;
          margin: 15mm 15mm 15mm 15mm;
        }
        body {
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
          /* White paper for all print variants (overrides the faint bg-background). */
          background-color: #fff !important;
        }
        a[href]::after {
          content: none;
        }
        .no-print {
          display: none !important;
        }
        .copy-btn {
          display: none !important;
        }
        /* No global break-inside: sections/cards are allowed to split naturally,
         * with orphan handling managed at component level. */

        /* Short print only: remove body padding (otherwise ~8mm of extra white space
         * on top of @page) to gain usable area for the 2-page target.
         * data-cv-variant is set by the toggle script below. */
        body[data-cv-variant='short'] {
          padding: 0 !important;
        }
      }
    </style>
  </head>
  <body class="bg-background font-satoshi text-foreground p-8 text-[0.88rem] leading-relaxed">
    <slot />
  </body>
</html>
