---
import BaseHead from '@/components/BaseHead.astro';
import { siteConfig } from '@/site-config';

interface Props {
  title?: string;
}
const { title = 'CV — Florian Lefevre' } = Astro.props;
---

<html lang={siteConfig.lang}>
  <head>
    <BaseHead title={title} description="Curriculum Vitae de Florian Lefevre" />
    <style>
      @media print {
        @page {
          size: A4;
          margin: 15mm 15mm 15mm 15mm;
        }
        body {
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }
        a[href]::after {
          content: none;
        }
        .no-print {
          display: none !important;
        }
        /* Pas de break-inside global : on laisse les sections/cards se découper
         * naturellement, l'orphelinage est géré au niveau composant. */

        /* PS uniquement : on libère le padding du body (sinon ~8mm de blanc en plus
         * par-dessus le @page) pour gagner de la zone utile sur la cible 2 pages.
         * Le data-cv-variant est posé par le script de toggle ci-dessous. */
        body[data-cv-variant="short"] {
          padding: 0 !important;
        }
      }
    </style>
  </head>
  <body class="bg-background font-satoshi text-foreground p-8 text-[0.88rem] leading-relaxed">
    <slot />
  </body>
</html>
