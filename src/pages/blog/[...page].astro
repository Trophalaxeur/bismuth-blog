---
export const prerender = true;

import type { GetStaticPaths, Page } from 'astro';
import type { PostEntry } from '@/utils';

import BlogListPage from '@/components/blog/BlogListPage.astro';
import { BLOG_PATHS } from '@/site-config';
import { getAllPosts, getUniqueTags, sortMDByDate } from '@/utils';

export const getStaticPaths = (async ({ paginate }) => {
  const allPosts = await getAllPosts();
  const allPostsByDate = sortMDByDate(allPosts);
  const uniqueTags = getUniqueTags(allPosts);
  return paginate(allPostsByDate, { pageSize: 10, props: { uniqueTags } });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<PostEntry>;
  uniqueTags: string[];
}

const { page, uniqueTags } = Astro.props as Props;

const meta = {
  description: "Mes articles, expérimentations et notes techniques sur le développement web, le homelab et les outils que j'utilise.",
  title: 'Blog',
};

const paginationProps = {
  ...(page.url.prev && { prevUrl: { text: `← Articles précédents`, url: page.url.prev } }),
  ...(page.url.next && { nextUrl: { text: `Articles suivants →`, url: page.url.next } }),
};
---

<BlogListPage
  page={page}
  meta={meta}
  backHref="/"
  baseUrl={BLOG_PATHS.fr}
  emptyMessage="Aucun article pour l'instant."
  paginationProps={paginationProps}
  uniqueTags={uniqueTags}
/>
