---
import CvPrintLayout from '@/layouts/CvPrintLayout.astro';
import CvPage from '@/components/cv/CvPage.astro';
---

<CvPrintLayout>
  <div id="variant-short">
    <CvPage variant="short" showSwitch={false} />
  </div>
  <div id="variant-detailed" style="display:none">
    <CvPage variant="detailed" showSwitch={false} />
  </div>

  <script>
    const params = new URLSearchParams(window.location.search);
    const variant = params.get('variant') === 'detailed' ? 'detailed' : 'short';
    document.body.dataset.cvVariant = variant;
    if (variant === 'detailed') {
      document.getElementById('variant-short')!.style.display = 'none';
      document.getElementById('variant-detailed')!.style.display = 'block';
    } else {
      // Short variant: tighter 10mm page margins (vs the layout's 15mm default)
      // to fit the printed short CV onto 2 pages. Scoped here so the detailed
      // dossier and the live print of detailed keep the airier 15mm margins.
      const style = document.createElement('style');
      style.textContent = '@media print{@page{margin:10mm}}';
      document.head.appendChild(style);
    }
  </script>
</CvPrintLayout>
