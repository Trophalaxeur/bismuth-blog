---
import CvCareerChannelPage from '@/components/cv/CvCareerChannelPage.astro';

// See print.astro in this same directory for the getStaticPaths([]) safety
// rationale — identical DEV-only gating.
export function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  const slug = import.meta.env.TAILORED_CV_SLUG;
  return slug && import.meta.env.LOCAL_CARBON_NOTES ? [{ params: { slug } }] : [];
}
---

<CvCareerChannelPage />
