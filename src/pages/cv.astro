---
import PageLayout from '@/layouts/BaseLayout.astro'
import Button from '@/components/Button.astro'
---

<PageLayout meta={{ title: 'CV', description: 'Curriculum Vitae de Florian Lefevre' }}>
	<div class='w-full'>
		<Button title='Retour' href='/' style='button'>
			<svg
				xmlns='http://www.w3.org/2000/svg'
				width='14'
				height='14'
				viewBox='0 0 24 24'
				slot='icon-before'
			>
				<path
					fill='currentColor'
					d='m6.921 12.5l5.792 5.792L12 19l-7-7l7-7l.713.708L6.921 11.5H19v1z'
				>
				</path>
			</svg>
		</Button>
		<div class='mt-8'>
			<h1 class='mb-4 text-2xl font-bold'>Curriculum Vitae</h1>
			<p class='text-muted-foreground'>Page en cours de construction.</p>
		</div>
	</div>
</PageLayout>
