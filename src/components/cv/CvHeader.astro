---
interface Props {
  name: string;
  title: string;
  baseline?: string;
  image?: string;
  location: string;
  contact: { email: string; phone?: string; github?: string };
}
const { name, title, baseline, image, location, contact } = Astro.props;
---

<header class="border-border/60 mb-12 border-b pb-10">
  <div class="flex items-start justify-between gap-8">
    <div class="flex-1">
      <h1 class="text-foreground text-4xl font-black tracking-tight">{name}</h1>
      <p class="text-foreground/75 mt-2 text-sm font-normal">{title}</p>
      {baseline && <p class="text-muted-foreground mt-2.5 text-[11px] leading-relaxed">{baseline}</p>}
      <div class="text-muted-foreground mt-5 flex flex-wrap gap-x-4 gap-y-1.5 text-xs">
        <span class="flex items-center gap-x-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24"
            ><path fill="currentColor" d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7m0 9.5a2.5 2.5 0 0 1 0-5a2.5 2.5 0 0 1 0 5"></path></svg
          >
          {location}
        </span>
        <a href={`mailto:${contact.email}`} class="hover:text-cv-accent flex items-center gap-x-1.5 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24"
            ><path fill="currentColor" d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2m0 4l-8 5l-8-5V6l8 5l8-5z"></path></svg
          >
          {contact.email}
        </a>
        {
          contact.phone && (
            <span class="flex items-center gap-x-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24">
                <path
                  fill="currentColor"
                  d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24c1.12.37 2.33.57 3.57.57c.55 0 1 .45 1 1V20c0 .55-.45 1-1 1c-9.39 0-17-7.61-17-17c0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1c0 1.25.2 2.45.57 3.57c.11.35.03.74-.25 1.02z"
                />
              </svg>
              {contact.phone}
            </span>
          )
        }
        {
          contact.github && (
            <a href={contact.github} target="_blank" class="hover:text-cv-accent flex items-center gap-x-1.5 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0" viewBox="0 0 16 16">
                <path
                  fill="currentColor"
                  d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59c.4.07.55-.17.55-.38c0-.19-.01-.82-.01-1.49c-2.01.37-2.53-.49-2.69-.94c-.09-.23-.48-.94-.82-1.13c-.28-.15-.68-.52-.01-.53c.63-.01 1.08.58 1.23.82c.72 1.21 1.87.87 2.33.66c.07-.52.28-.87.51-1.07c-1.78-.2-3.64-.89-3.64-3.95c0-.87.31-1.59.82-2.15c-.08-.2-.36-1.02.08-2.12c0 0 .67-.21 2.2.82c.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82c.44 1.1.16 1.92.08 2.12c.51.56.82 1.27.82 2.15c0 3.07-1.87 3.75-3.65 3.95c.29.25.54.73.54 1.48c0 1.07-.01 1.93-.01 2.2c0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8"
                />
              </svg>
              GitHub
            </a>
          )
        }
      </div>
    </div>
    {image && <img src={image} alt={name} class="ring-border/50 mt-1 h-28 w-28 shrink-0 rounded-full object-cover object-top shadow-lg ring-1" />}
  </div>
</header>
