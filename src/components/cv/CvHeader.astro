---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import ObfuscatedEmail from '@/components/ObfuscatedEmail.astro';
import { colorizePlainTechTerms } from '@/utils';

interface Props {
  name: string;
  title: string;
  baseline?: string;
  image?: string;
  location: string;
  contact: { email: string; phone?: string; github?: string; linkedin?: string };
  variant?: 'short' | 'detailed';
  showSwitch?: boolean;
  bioHtml?: string;
}
const { name, title, baseline, image, location, contact, variant, showSwitch = true, bioHtml } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/*.{png,jpg,jpeg,webp}', { eager: true });
const resolvedImage = image ? images[`/src/assets${image}`]?.default : undefined;
if (image && !resolvedImage) {
  throw new Error(`CvHeader: image "${image}" not found in /src/assets/images/`);
}

const displayUrl = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---

<header id="profil" class="border-border/40 print-short:mb-2 print-short:pb-2 mb-6 border-b pb-5 print:mb-3 print:pb-3">
  <h1 class="sr-only">{name} — {title}</h1>

  <div class="print-short:gap-3 grid items-start gap-6 sm:grid-cols-[1fr_minmax(180px,220px)] sm:gap-6 print:gap-4">
    <div class="min-w-0">
      {
        showSwitch ? (
          <p class="text-foreground print-short:text-[1.75rem] print-short:leading-tight text-3xl font-black tracking-tight sm:text-[2.25rem] sm:leading-[1.1]" aria-hidden="true">
            {title}
          </p>
        ) : (
          <>
            <p class="text-foreground print-short:text-2xl print-short:leading-tight text-4xl font-black tracking-tight" aria-hidden="true">
              {name}
            </p>
            <p class="text-foreground/85 print-short:mt-1.5 print-short:text-[1.35rem] print-short:font-bold mt-3 text-2xl font-bold tracking-tight" aria-hidden="true">
              {title}
            </p>
          </>
        )
      }
      {
        baseline && (
          <p class="text-foreground/70 print-short:mt-1 print-short:text-[11.5px] mt-2 text-[14px] font-medium tracking-tight" set:html={colorizePlainTechTerms(baseline)} />
        )
      }
      {
        bioHtml && (
          <div
            class="prose prose-sm dark:prose-invert prose-p:my-2 prose-p:leading-[1.75] prose-p:text-foreground/85 print-short:mt-2 print-short:[&_p]:my-1 print-short:[&_p]:leading-[1.45] print-short:[&_p]:text-[11.5px] mt-5 max-w-none"
            set:html={bioHtml}
          />
        )
      }
    </div>

    <aside class="flex flex-row items-start gap-5 sm:flex-col sm:items-end sm:gap-6">
      {
        resolvedImage && (
          <Image
            src={resolvedImage}
            alt={name}
            width={128}
            height={128}
            loading="lazy"
            decoding="async"
            class="ring-border/60 print-short:h-20 print-short:w-20 h-28 w-28 shrink-0 rounded-full object-cover object-top shadow-sm ring-1"
          />
        )
      }
      <div class="text-muted-foreground print-short:gap-y-1 print-short:text-[10px] flex flex-col gap-y-2 text-xs sm:items-end">
        <span class="flex items-center gap-x-2 sm:flex-row-reverse">
          <svg xmlns="http://www.w3.org/2000/svg" class="text-cv-accent/80 h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24"
            ><path fill="currentColor" d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7m0 9.5a2.5 2.5 0 0 1 0-5a2.5 2.5 0 0 1 0 5"></path></svg
          >
          <span class="truncate">{location}</span>
        </span>
        <ObfuscatedEmail email={contact.email} class="hover:text-cv-accent flex items-center gap-x-2 transition-colors sm:flex-row-reverse" displayClass="truncate">
          <svg xmlns="http://www.w3.org/2000/svg" class="text-cv-accent/80 h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24"
            ><path fill="currentColor" d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2m0 4l-8 5l-8-5V6l8 5l8-5z"></path></svg
          >
        </ObfuscatedEmail>
        {
          contact.phone && (
            <span class="flex items-center gap-x-2 sm:flex-row-reverse">
              <svg xmlns="http://www.w3.org/2000/svg" class="text-cv-accent/80 h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24">
                <path
                  fill="currentColor"
                  d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24c1.12.37 2.33.57 3.57.57c.55 0 1 .45 1 1V20c0 .55-.45 1-1 1c-9.39 0-17-7.61-17-17c0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1c0 1.25.2 2.45.57 3.57c.11.35.03.74-.25 1.02z"
                />
              </svg>
              <span class="truncate">{contact.phone}</span>
            </span>
          )
        }
        {
          contact.github && (
            <a href={contact.github} target="_blank" rel="noopener noreferrer" class="hover:text-cv-accent flex items-center gap-x-2 transition-colors sm:flex-row-reverse">
              <svg xmlns="http://www.w3.org/2000/svg" class="text-cv-accent/80 h-3.5 w-3.5 shrink-0" viewBox="0 0 16 16">
                <path
                  fill="currentColor"
                  d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59c.4.07.55-.17.55-.38c0-.19-.01-.82-.01-1.49c-2.01.37-2.53-.49-2.69-.94c-.09-.23-.48-.94-.82-1.13c-.28-.15-.68-.52-.01-.53c.63-.01 1.08.58 1.23.82c.72 1.21 1.87.87 2.33.66c.07-.52.28-.87.51-1.07c-1.78-.2-3.64-.89-3.64-3.95c0-.87.31-1.59.82-2.15c-.08-.2-.36-1.02.08-2.12c0 0 .67-.21 2.2.82c.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82c.44 1.1.16 1.92.08 2.12c.51.56.82 1.27.82 2.15c0 3.07-1.87 3.75-3.65 3.95c.29.25.54.73.54 1.48c0 1.07-.01 1.93-.01 2.2c0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8"
                />
              </svg>
              <span class="truncate">{displayUrl(contact.github)}</span>
            </a>
          )
        }
        {
          contact.linkedin && (
            <a href={contact.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-cv-accent flex items-center gap-x-2 transition-colors sm:flex-row-reverse">
              <svg xmlns="http://www.w3.org/2000/svg" class="text-cv-accent/80 h-3.5 w-3.5 shrink-0" viewBox="0 0 16 16">
                <path
                  fill="currentColor"
                  d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248c-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586c.173-.431.568-.878 1.232-.878c.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252c-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z"
                />
              </svg>
              <span class="truncate">{displayUrl(contact.linkedin)}</span>
            </a>
          )
        }
      </div>
    </aside>
  </div>

  {
    showSwitch && (
      <nav class="text-muted-foreground mt-4 flex flex-wrap justify-between gap-x-3 text-[11px] whitespace-nowrap sm:hidden" aria-label="Sections">
        <a href="#profil" class="hover:text-cv-accent transition-colors">
          Profil
        </a>
        {variant === 'detailed' && (
          <a href="#domaines" class="hover:text-cv-accent transition-colors">
            Domaines
          </a>
        )}
        <a href="#competences" class="hover:text-cv-accent transition-colors">
          Compétences
        </a>
        <a href="#experiences" class="hover:text-cv-accent transition-colors">
          Expériences
        </a>
        <a href="#formation" class="hover:text-cv-accent transition-colors">
          Formation
        </a>
        <a href="#projets" class="hover:text-cv-accent transition-colors">
          Projets
        </a>
      </nav>
    )
  }
</header>
