---
import { getCollection } from 'astro:content';
import { extractVariantMarkdown, renderMarkdown, sortCvExperiences } from '@/utils';
import type { CvVariant } from '@/utils';
import CvHeader from './CvHeader.astro';
import CvProfile from './CvProfile.astro';
import CvSkills from './CvSkills.astro';
import CvExperienceList from './CvExperienceList.astro';
import CvEducation from './CvEducation.astro';
import CvProjects from './CvProjects.astro';
import CvExtraInfo from './CvExtraInfo.astro';

interface Props {
  variant: Exclude<CvVariant, 'career-channel'>;
  showSwitch?: boolean;
}
const { variant, showSwitch = true } = Astro.props;

// Load sections
const allSections = await getCollection('cvSections');
const find = (type: string) => allSections.find((e) => e.data.type === type);

const profileEntry = find('profile');
const skillsEntry = find('skills');
const educationEntry = find('education');
const projectsEntry = find('projects');
const extraInfoEntry = find('extra-info');

const render = async (entry: (typeof allSections)[number] | undefined) => (entry ? renderMarkdown(extractVariantMarkdown(entry.body ?? '', variant)) : '');

const [profileHtml, educationHtml, projectsHtml, extraInfoHtml] = await Promise.all([render(profileEntry), render(educationEntry), render(projectsEntry), render(extraInfoEntry)]);

// Load, filter and sort experiences
const allExperiences = await getCollection('cvExperiences');
const visibleExperiences = variant === 'short' ? allExperiences.filter((e) => !e.data.variants || e.data.variants.includes('short')) : allExperiences;

const sortedExperiences = sortCvExperiences(visibleExperiences);

const experiencesData = await Promise.all(
  sortedExperiences.map(async (exp) => ({
    company: exp.data.company,
    role: exp.data.role,
    start: exp.data.start,
    end: exp.data.end,
    current: exp.data.current,
    tags: exp.data.tags,
    secondaryTags: exp.data.secondaryTags,
    html: await renderMarkdown(extractVariantMarkdown(exp.body ?? '', variant)),
  }))
);
---

{
  profileEntry?.data && (
    <CvHeader
      name={profileEntry.data.name ?? ''}
      title={profileEntry.data.title ?? ''}
      baseline={profileEntry.data.baseline}
      image={profileEntry.data.image}
      location={profileEntry.data.location ?? ''}
      contact={profileEntry.data.contact ?? { email: '' }}
      variant={variant}
      showSwitch={showSwitch}
    />
  )
}

<CvProfile html={profileHtml} />
<CvSkills skills={skillsEntry?.data.skills ?? {}} />
<CvExperienceList experiences={experiencesData} variant={variant} />
<CvEducation html={educationHtml} />
{projectsHtml && <CvProjects html={projectsHtml} />}
{extraInfoHtml && <CvExtraInfo html={extraInfoHtml} />}
