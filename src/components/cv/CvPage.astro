---
import { getCollection } from 'astro:content';
import { annotateExperienceHtml, extractVariantMarkdown, flattenEnvironment, parseDomains, renderMarkdown, sortCvExperiences } from '@/utils';
import type { CvVariant } from '@/utils';
import CvHeader from './CvHeader.astro';
import CvDomains from './CvDomains.astro';
import CvSummary from './CvSummary.astro';
import CvSkills from './CvSkills.astro';
import CvExperienceList from './CvExperienceList.astro';
import CvAppendix from './CvAppendix.astro';

interface Props {
  variant: Exclude<CvVariant, 'career-channel'>;
  showSwitch?: boolean;
}
const { variant, showSwitch = true } = Astro.props;

// Load sections
const allSections = await getCollection('cvSections');
const find = (type: string) => allSections.find((e) => e.data.type === type);

const profileEntry = find('profile');
const skillsEntry = find('skills');
const educationEntry = find('education');
const projectsEntry = find('projects');
const extraInfoEntry = find('extra-info');
const domainsEntry = find('domains');
const summaryEntry = find('summary');
const interestsEntry = find('interests');

const render = async (entry: (typeof allSections)[number] | undefined) => (entry ? renderMarkdown(extractVariantMarkdown(entry.body ?? '', variant)) : '');

const [profileHtml, educationHtml, projectsHtml, extraInfoHtml, summaryHtml, interestsHtml] = await Promise.all([
  render(profileEntry),
  render(educationEntry),
  render(projectsEntry),
  render(extraInfoEntry),
  render(summaryEntry),
  render(interestsEntry),
]);

const domains = domainsEntry ? parseDomains(extractVariantMarkdown(domainsEntry.body ?? '', variant)) : [];

// Load, filter and sort experiences.
// The `variants` allowlist is applied for both variants (short AND detailed):
// an experience without `variants` is always displayed (fallback), otherwise it
// must explicitly declare the current variant.
const allExperiences = await getCollection('cvExperiences');
const visibleExperiences = allExperiences.filter((e) => !e.data.variants || e.data.variants.includes(variant));

const sortedExperiences = sortCvExperiences(visibleExperiences);

const experiencesData = await Promise.all(
  sortedExperiences.map(async (exp) => {
    const rawHtml = await renderMarkdown(extractVariantMarkdown(exp.body ?? '', variant));
    const envString = variant === 'detailed' ? flattenEnvironment(exp.data.environment) : '';
    const html = variant === 'detailed' ? annotateExperienceHtml(rawHtml, envString) : rawHtml;
    // For the detailed page, also render the short-variant body so the card can collapse to a summary view.
    const shortHtml = variant === 'detailed' ? await renderMarkdown(extractVariantMarkdown(exp.body ?? '', 'short')) : '';
    return {
      company: exp.data.company,
      clientLocation: exp.data.clientLocation,
      employer: exp.data.employer,
      role: exp.data.role,
      start: exp.data.start,
      end: exp.data.end,
      current: exp.data.current,
      tags: exp.data.tags,
      secondaryTags: exp.data.secondaryTags,
      section: exp.data.section,
      html,
      shortHtml,
    };
  })
);

const appendix = {
  formation: { title: 'Formation', html: educationHtml, id: 'formation', icon: 'graduation-cap' as const },
  projects: { title: 'Projets personnels & expérimentations', html: projectsHtml, id: 'projets', icon: 'code-2' as const },
  extraInfo: { title: 'Informations complémentaires', html: extraInfoHtml, id: 'infos', icon: 'info' as const },
  interests: { title: "Centres d'intérêt", html: interestsHtml, id: 'interets', icon: 'heart' as const },
};
---

{
  profileEntry?.data && (
    <CvHeader
      name={profileEntry.data.name ?? ''}
      title={profileEntry.data.title ?? ''}
      baseline={profileEntry.data.baseline}
      image={profileEntry.data.image}
      location={profileEntry.data.location ?? ''}
      contact={profileEntry.data.contact ?? { email: '' }}
      variant={variant}
      showSwitch={showSwitch}
      bioHtml={profileHtml}
    />
  )
}

{variant === 'detailed' && summaryHtml && <CvSummary html={summaryHtml} />}
{variant === 'detailed' && domains.length > 0 && <CvDomains domains={domains} />}
<CvSkills skills={skillsEntry?.data.skills ?? {}} variant={variant} />
<CvExperienceList experiences={experiencesData} variant={variant} />
<CvAppendix formation={appendix.formation} projects={appendix.projects} extraInfo={appendix.extraInfo} interests={appendix.interests} />
