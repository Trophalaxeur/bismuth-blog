---
interface Props {
  html: string;
}
const { html } = Astro.props;
---

<section id="projets" class="mb-12">
  <h2 class="border-border/60 text-foreground/70 mb-6 border-b pb-2 text-xs font-bold tracking-[0.12em] uppercase">Projets personnels, veille & expérimentation</h2>
  <div
    class="prose prose-sm dark:prose-invert prose-h3:text-sm prose-h3:font-semibold prose-h3:mt-4 prose-h3:mb-1 prose-p:my-1 prose-ul:my-1 prose-li:my-0 max-w-none"
    set:html={html}
  />
</section>
