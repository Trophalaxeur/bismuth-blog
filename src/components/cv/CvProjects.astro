---
interface Props {
	html: string
}
const { html } = Astro.props
---

<section class='mb-12'>
	<h2 class='mb-5 border-b border-border/60 pb-2 text-[11px] font-bold uppercase tracking-[0.12em] text-foreground/50'>
		Projets personnels
	</h2>
	<div class='prose prose-sm max-w-none dark:prose-invert prose-h3:text-sm prose-h3:font-semibold prose-h3:mt-4 prose-h3:mb-1 prose-p:my-1 prose-ul:my-1 prose-li:my-0' set:html={html} />
</section>
