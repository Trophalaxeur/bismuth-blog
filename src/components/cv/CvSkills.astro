---
interface Props {
	html: string
	skills: Record<string, string[]>
}
const { skills } = Astro.props

const labels: Record<string, string> = {
	frontend: 'Frontend',
	backend: 'Backend & Fullstack',
	databases: 'Bases de données',
	devops: 'DevOps & CI/CD',
	tools: 'Outils',
	methods: 'Méthodes'
}

const entries = Object.entries(skills).filter(([, items]) => items.length > 0)
---

<section id='competences' class='mb-12'>
	<h2 class='mb-5 border-b border-border/60 pb-2 text-[11px] font-bold uppercase tracking-[0.12em] text-foreground/50'>
		Compétences
	</h2>
	{
		entries.length > 0 ? (
			<dl class='grid grid-cols-[8rem_1fr] gap-x-4 gap-y-2'>
				{entries.map(([key, items]) => (
					<>
						<dt class='pt-0.5 text-xs font-semibold text-muted-foreground'>
							{labels[key] ?? key}
						</dt>
						<dd class='text-sm leading-relaxed'>{items.join(' · ')}</dd>
					</>
				))}
			</dl>
		) : null
	}
</section>
