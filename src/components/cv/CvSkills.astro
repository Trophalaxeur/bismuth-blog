---
interface Props {
  skills: Record<string, string[]>;
}
const { skills } = Astro.props;

const labels: Record<string, string> = {
  frontend: 'Frontend',
  backend: 'Backend & Fullstack',
  databases: 'Bases de données',
  devops: 'DevOps & CI/CD',
  tools: 'Outils',
  methods: 'Méthodes & collaboration',
  leadership: 'Leadership technique & architecture',
  delivery: 'Management & delivery',
  quality: 'Qualité & amélioration continue',
  ia: 'IA assistée',
};

const entries = Object.entries(skills).filter(([, items]) => items.length > 0);
---

<section id="competences" class="mb-12">
  <h2 class="border-border/60 text-foreground/70 mb-6 border-b pb-2 text-xs font-bold tracking-[0.12em] uppercase">Compétences</h2>
  {
    entries.length > 0 ? (
      <dl class="grid grid-cols-[8rem_1fr] gap-x-4 gap-y-2">
        {entries.map(([key, items]) => (
          <>
            <dt class="text-muted-foreground pt-0.5 text-xs font-semibold">{labels[key] ?? key}</dt>
            <dd class="text-sm leading-relaxed">{items.join(' · ')}</dd>
          </>
        ))}
      </dl>
    ) : null
  }
</section>
