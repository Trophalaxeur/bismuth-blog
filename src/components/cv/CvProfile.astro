---
interface Props {
  html: string;
}
const { html } = Astro.props;
---

<section id="profil" class="mb-12">
  <h2 class="border-border/60 text-foreground/50 mb-5 border-b pb-2 text-[11px] font-bold tracking-[0.12em] uppercase">Profil</h2>
  <div class="prose prose-sm dark:prose-invert prose-p:my-1.5 prose-p:leading-[1.7] max-w-none" set:html={html} />
</section>
