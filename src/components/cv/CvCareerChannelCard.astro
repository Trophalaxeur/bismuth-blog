---
import { formatCvPeriod, CAREER_CHANNEL_MAX_CHARS } from '@/utils';

interface Props {
  company: string;
  role: string;
  start: string;
  end?: string;
  current?: boolean;
  tags?: string[];
  /** Plain text, Markdown already stripped — ready to paste into a career channel platform. */
  text: string;
}
const { company, role, start, end, current, tags, text } = Astro.props;

const period = formatCvPeriod(start, end, current);
const charCount = text.length;
const isOverLimit = charCount > CAREER_CHANNEL_MAX_CHARS;
---

<article class="border-cv-accent/40 bg-cv-accent/5 mb-10 rounded-lg border-2 p-6">
  <!-- Header: identity + copy buttons -->
  <div class="mb-4 flex flex-wrap items-start justify-between gap-3">
    <div class="flex min-w-0 items-start gap-2">
      <div class="min-w-0">
        <p class="text-foreground text-sm font-bold leading-snug">
          {company}
          <span class="text-foreground/65 font-normal">· {role}</span>
        </p>
        <p class="text-muted-foreground mt-0.5 text-xs tabular-nums">{period}</p>
      </div>
      <!--
        Copy role button — copies the role title only (company is a separate field on most platforms).
        SVG is intentionally inline: Astro cannot share markup between the template and the <script>
        block; a third copy lives in ICON_CLIPBOARD below for the post-click restore animation.
      -->
      <button
        class="copy-btn text-muted-foreground hover:text-cv-accent hover:bg-cv-accent/10 focus-visible:ring-cv-accent mt-0.5 shrink-0 rounded p-1 transition-colors focus-visible:outline-none focus-visible:ring-2"
        data-text={role}
        aria-label={`Copier le poste : ${role}`}
        title="Copier le titre du poste"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="8" height="4" x="8" y="2" rx="1"/>
          <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
        </svg>
      </button>
    </div>

    <!-- Copy description button -->
    <button
      class="copy-btn bg-cv-accent/12 text-cv-accent hover:bg-cv-accent/25 focus-visible:ring-cv-accent shrink-0 rounded-md p-2 transition-colors focus-visible:outline-none focus-visible:ring-2"
      data-text={text}
      aria-label={`Copier la description de ${company}`}
      title="Copier la description"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect width="8" height="4" x="8" y="2" rx="1"/>
        <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
      </svg>
    </button>
  </div>

  {
    tags && tags.length > 0 && (
      <div class="mb-3 flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <span class="bg-cv-accent/20 text-cv-accent inline-flex h-6 items-center rounded-full px-2.5 text-[11px] font-medium">{tag}</span>
        ))}
      </div>
    )
  }

  <!-- Body: plain text, no overflow, no monospace -->
  <div
    class="text-foreground/80 border-cv-accent/20 bg-cv-accent/5 rounded-md border p-4 text-sm leading-relaxed"
    style="white-space: pre-wrap; word-break: break-word; overflow-wrap: break-word;"
  >{text}</div>

  <!-- Footer: character counter -->
  <p class={`mt-2.5 text-right text-[11px] tabular-nums ${isOverLimit ? 'font-semibold text-red-500' : 'text-muted-foreground'}`}>
    {charCount.toLocaleString('fr-FR')} / {CAREER_CHANNEL_MAX_CHARS.toLocaleString('fr-FR')} caractères
    {isOverLimit && ' — dépasse la limite de la plateforme'}
  </p>
</article>

<script>
  // Hardcoded SVG constants — no user data is ever interpolated here (no XSS risk).
  // h-4 w-4 is used for both buttons on restore; the role button loses its h-3.5 after click,
  // which is acceptable given the 2 s timeout.
  const ICON_CLIPBOARD = `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="4" x="8" y="2" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/></svg>`;
  const ICON_CHECK = `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`;

  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.text ?? '';
      try {
        await navigator.clipboard.writeText(text);
        btn.innerHTML = ICON_CHECK;
        // ! modifier needed to override the button's base text-color utility classes
        btn.classList.add('!text-green-600', 'dark:!text-green-400');
        setTimeout(() => {
          btn.innerHTML = ICON_CLIPBOARD;
          btn.classList.remove('!text-green-600', 'dark:!text-green-400');
        }, 2000);
      } catch {
        // Clipboard API unavailable — shouldn't happen in this usage context
      }
    });
  });
</script>
