---
import CvPrintButton from './CvPrintButton.astro';
import CvDownloadButton from './CvDownloadButton.astro';

interface Props {
  variant: 'short' | 'detailed' | 'career-channel';
}
const { variant } = Astro.props;

// PDFs generated by `npm run cv:pdf` into public/ (served at root). The downloaded
// filename (download attr) reuses the names defined in profile.md.
const PDF = {
  short: { href: '/cv-short.pdf', filename: 'florian-lefevre-cv.pdf' },
  detailed: { href: '/cv-detailed.pdf', filename: 'florian-lefevre-dossier-competences.pdf' },
  'career-channel': { href: '/cv-career-channel.pdf', filename: 'florian-lefevre-reseau.pdf' },
} as const;
const pdf = PDF[variant];

const downloadLabel = {
  short: 'Télécharger le PDF court',
  detailed: 'Télécharger le PDF détaillé',
  'career-channel': 'Télécharger le PDF réseau',
} as const;

const linkBase = 'px-3 py-1.5 text-sm transition-colors';
const linkActive = 'bg-cv-accent/10 text-cv-accent font-semibold';
const linkInactive = 'text-foreground/70 hover:text-foreground';
---

<div class="flex items-center gap-2">
  <div class="border-border flex items-stretch rounded-md border">
    <a href="/cv" class={`${linkBase} rounded-l-md ${variant === 'short' ? linkActive : linkInactive}`} aria-current={variant === 'short' ? 'page' : undefined}> Court </a>
    <a
      href="/cv/detailed"
      class={`${linkBase} border-border border-l ${variant === 'detailed' ? linkActive : linkInactive}`}
      aria-current={variant === 'detailed' ? 'page' : undefined}
    >
      Détaillé
    </a>
    <a
      href="/cv/career-channel"
      class={`${linkBase} border-border rounded-r-md border-l ${variant === 'career-channel' ? linkActive : linkInactive}`}
      aria-current={variant === 'career-channel' ? 'page' : undefined}
    >
      Réseau
    </a>
  </div>
  <CvPrintButton variant={variant} />
  <CvDownloadButton href={pdf.href} filename={pdf.filename} label={downloadLabel[variant]} />
</div>
