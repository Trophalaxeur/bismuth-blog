---
import CvPrintButton from './CvPrintButton.astro';
import CvDownloadButton from './CvDownloadButton.astro';
import CvLangSwitch from './CvLangSwitch.astro';
import { getCvLabels } from '@/utils';

interface Props {
  variant: 'short' | 'detailed' | 'career-channel';
}
const { variant } = Astro.props;

const locale = Astro.currentLocale ?? 'fr';
const cvBase = locale === 'en' ? '/en/cv' : '/cv';
const L = getCvLabels(locale);

// PDFs generated by `npm run cv:pdf` into public/ (served at root).
// FR: cv-short.pdf / cv-detailed.pdf / cv-career-channel.pdf
// EN: cv-short-en.pdf / cv-detailed-en.pdf / cv-career-channel-en.pdf
const PDF_FR = {
  short: { href: '/cv-short.pdf', filename: 'florian-lefevre-cv.pdf' },
  detailed: { href: '/cv-detailed.pdf', filename: 'florian-lefevre-dossier-competences.pdf' },
  'career-channel': { href: '/cv-career-channel.pdf', filename: 'florian-lefevre-reseau.pdf' },
} as const;
const PDF_EN = {
  short: { href: '/cv-short-en.pdf', filename: 'florian-lefevre-resume.pdf' },
  detailed: { href: '/cv-detailed-en.pdf', filename: 'florian-lefevre-portfolio.pdf' },
  'career-channel': { href: '/cv-career-channel-en.pdf', filename: 'florian-lefevre-network.pdf' },
} as const;
const pdf = (locale === 'en' ? PDF_EN : PDF_FR)[variant];

const downloadLabel = {
  short: L.downloadLabels.short,
  detailed: L.downloadLabels.detailed,
  'career-channel': L.downloadLabels.careerChannel,
} as const;

const linkBase = 'px-3 py-1.5 text-sm transition-colors';
const linkActive = 'bg-cv-accent/10 text-cv-accent font-semibold';
const linkInactive = 'text-foreground/70 hover:text-foreground';
---

<div class="flex items-center gap-2">
  <CvLangSwitch />
  <div class="border-border flex items-stretch rounded-md border">
    <a href={cvBase} class={`${linkBase} rounded-l-md ${variant === 'short' ? linkActive : linkInactive}`} aria-current={variant === 'short' ? 'page' : undefined}
      >{L.variantLabels.short}</a
    >
    <a
      href={`${cvBase}/detailed`}
      class={`${linkBase} border-border border-l ${variant === 'detailed' ? linkActive : linkInactive}`}
      aria-current={variant === 'detailed' ? 'page' : undefined}
    >
      {L.variantLabels.detailed}
    </a>
    <a
      href={`${cvBase}/career-channel`}
      class={`${linkBase} border-border rounded-r-md border-l ${variant === 'career-channel' ? linkActive : linkInactive}`}
      aria-current={variant === 'career-channel' ? 'page' : undefined}
    >
      {L.variantLabels.careerChannel}
    </a>
  </div>
  <CvPrintButton variant={variant} />
  <CvDownloadButton href={pdf.href} filename={pdf.filename} label={downloadLabel[variant]} />
</div>
