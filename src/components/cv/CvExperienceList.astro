---
import CvExperienceCard from './CvExperienceCard.astro'

interface Props {
	experiences: Array<{
		company: string
		role: string
		start: string
		end?: string
		current?: boolean
		tags?: string[]
		html: string
	}>
	variant: 'short' | 'detailed'
}
const { experiences, variant } = Astro.props
---

<section id='experiences' class='mb-12'>
	<h2 class='mb-6 border-b border-border/60 pb-2 text-[11px] font-bold uppercase tracking-[0.12em] text-foreground/50'>
		Expériences professionnelles
	</h2>
	{
		experiences.map((exp) => (
			<CvExperienceCard
				company={exp.company}
				role={exp.role}
				start={exp.start}
				end={exp.end}
				current={exp.current}
				tags={exp.tags}
				html={exp.html}
				variant={variant}
			/>
		))
	}
</section>
