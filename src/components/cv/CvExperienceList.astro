---
import CvExperienceCard from './CvExperienceCard.astro';

interface Props {
  experiences: Array<{
    company: string;
    role: string;
    start: string;
    end?: string;
    current?: boolean;
    tags?: string[];
    secondaryTags?: string[];
    html: string;
  }>;
  variant: 'short' | 'detailed';
}
const { experiences, variant } = Astro.props;
---

<section id="experiences" class="mb-12">
  <h2 class="border-border/60 text-foreground/70 mb-6 border-b pb-2 text-xs font-bold tracking-[0.12em] uppercase">Expériences professionnelles</h2>
  {
    experiences.map((exp) => (
      <CvExperienceCard
        company={exp.company}
        role={exp.role}
        start={exp.start}
        end={exp.end}
        current={exp.current}
        tags={exp.tags}
        secondaryTags={exp.secondaryTags}
        html={exp.html}
        variant={variant}
      />
    ))
  }
</section>
