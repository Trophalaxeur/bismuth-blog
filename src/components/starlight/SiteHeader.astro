---
import { siteConfig, menuLinks } from '@/site-config';
import Search from '@astrojs/starlight/components/Search.astro';
---

<header class="site-header">
  <nav class="site-nav" aria-label="global">
    <a class="site-brand" href="/">{siteConfig.author}</a>
    <div class="site-actions">
      {
        menuLinks
          .filter(({ path, devOnly }) => path !== '/' && (!devOnly || import.meta.env.DEV))
          .map(({ title, path }) => (
            <a href={path} class="site-link">{title}</a>
          ))
      }
      <div class="lang-switch" aria-label="Language">
        <a href="/" class="lang-btn" title="Français" aria-label="Français">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 21 15" width="21" height="15" role="img" aria-hidden="true" class="flag-svg">
            <rect width="7" height="15" fill="#002395"></rect>
            <rect x="7" width="7" height="15" fill="#fff"></rect>
            <rect x="14" width="7" height="15" fill="#ED2939"></rect>
          </svg>
        </a>
        <a href="/en/" class="lang-btn lang-btn--active" title="English" aria-label="English" aria-current="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 60 30" width="21" height="15" role="img" aria-hidden="true" class="flag-svg">
            <defs>
              <clipPath id="docs-uk-flag-clip">
                <path d="M0 0v30h60V0z"></path>
              </clipPath>
            </defs>
            <path d="M0 0v30h60V0z" fill="#012169"></path>
            <path d="M0 0l60 30m0-30L0 30" stroke="#fff" stroke-width="6"></path>
            <path d="M0 0l60 30m0-30L0 30" stroke="#C8102E" stroke-width="4" clip-path="url(#docs-uk-flag-clip)"></path>
            <path d="M30 0v30M0 15h60" stroke="#fff" stroke-width="10"></path>
            <path d="M30 0v30M0 15h60" stroke="#C8102E" stroke-width="6"></path>
          </svg>
        </a>
      </div>
      <Search />
      <button id="sl-theme-toggle" class="theme-toggle" aria-label="Toggle theme">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" class="icon-sun">
          <path fill="currentColor" d="M12 15q1.25 0 2.125-.875T15 12q0-1.25-.875-2.125T12 9q-1.25 0-2.125.875T9 12q0 1.25.875 2.125T12 15m0 1q-1.671 0-2.836-1.164T8 12q0-1.671 1.164-2.836T12 8q1.671 0 2.836 1.164T16 12q0 1.671-1.164 2.836T12 16m-7-3.5H1.5v-1H5zm17.5 0H19v-1h3.5zM11.5 5V1.5h1V5zm0 17.5V19h1v3.5zM6.746 7.404l-2.16-2.098l.695-.744l2.111 2.134zM18.72 19.438l-2.117-2.14l.652-.702l2.16 2.098zM16.596 6.746l2.098-2.16l.744.695l-2.134 2.111zM4.562 18.72l2.14-2.117l.663.652l-2.078 2.179zM12 12" />
        </svg>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" class="icon-moon">
          <path fill="currentColor" d="M12.058 20q-3.334 0-5.667-2.333Q4.058 15.333 4.058 12q0-3.038 1.98-5.27Q8.02 4.5 10.942 4.097q.081 0 .159.006t.153.017q-.506.706-.801 1.57q-.295.865-.295 1.811q0 2.667 1.866 4.533q1.867 1.867 4.534 1.867q.952 0 1.813-.295q.862-.295 1.548-.801q.012.075.018.153q.005.078.005.158q-.384 2.923-2.615 4.904T12.057 20" />
        </svg>
      </button>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    border-bottom: 1px solid var(--sl-color-hairline);
    background: color-mix(in srgb, var(--sl-color-bg-nav) 90%, transparent);
    backdrop-filter: blur(12px);
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    font-family: var(--sl-font);
  }

  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 68rem;
    margin: 0 auto;
    width: 100%;
    gap: 1rem;
  }

  .site-brand {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--sl-color-text);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .site-brand:hover {
    color: var(--sl-color-text-accent);
  }

  .site-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .site-link {
    color: var(--sl-color-text);
    text-decoration: none;
    font-weight: 500;
    white-space: nowrap;
  }

  .site-link:hover {
    color: var(--sl-color-text-accent);
  }

  .lang-switch {
    display: flex;
    align-items: center;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.375rem;
    overflow: hidden;
  }

  .lang-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.3rem 0.45rem;
    transition: background 0.15s;
  }

  .lang-btn:hover {
    background: var(--sl-color-gray-6);
  }

  .lang-btn--active {
    background: color-mix(in srgb, var(--sl-color-accent) 12%, transparent);
  }

  .lang-btn + .lang-btn {
    border-left: 1px solid var(--sl-color-hairline);
  }

  .flag-svg {
    border-radius: 2px;
    display: block;
  }

  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.375rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.375rem;
    background: transparent;
    color: var(--sl-color-text);
    cursor: pointer;
    transition: background 0.15s;
  }

  .theme-toggle:hover {
    background: var(--sl-color-gray-1);
  }

  .icon-sun { display: block; }
  .icon-moon { display: none; }

  [data-theme='dark'] .icon-sun,
  :global(.dark) .icon-sun { display: none; }

  [data-theme='dark'] .icon-moon,
  :global(.dark) .icon-moon { display: block; }
</style>

<script is:inline type="module">
  async function initMermaid() {
    const blocks = [...document.querySelectorAll('pre > code.language-mermaid')];
    if (!blocks.length) return;

    const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs');
    const theme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'default';
    mermaid.initialize({ startOnLoad: false, theme });

    blocks.forEach((code) => {
      const div = document.createElement('div');
      div.className = 'mermaid';
      div.textContent = code.textContent ?? '';
      code.parentElement?.replaceWith(div);
    });

    await mermaid.run();
  }

  document.addEventListener('DOMContentLoaded', () => { initMermaid(); });
</script>

<script>
  function getTheme(): string {
    return localStorage.getItem('theme') ?? 'light';
  }

  function applyTheme(theme: string) {
    const html = document.documentElement;
    html.dataset.theme = theme;
    if (theme === 'dark') {
      html.classList.add('dark');
    } else {
      html.classList.remove('dark');
    }
    localStorage.setItem('theme', theme);
  }

  // Sync on load
  applyTheme(getTheme());

  // Wire up toggle button
  const btn = document.getElementById('sl-theme-toggle');
  btn?.addEventListener('click', () => {
    applyTheme(getTheme() === 'dark' ? 'light' : 'dark');
  });

  // Also respond to events fired by the blog's toggle (if navigating between sections)
  document.addEventListener('theme-change', (e) => {
    applyTheme((e as CustomEvent<{ theme: string }>).detail.theme);
  });
</script>
