direction: down

title: "Decision tree: Claude Code, Copilot Agent and homelab"

start: "Start"

q1: "Does the task need to send an email,\ngenerate a recap, or produce\na highly custom output?"

q2: "Is it purely reading,\nsynthesis, or reporting?"

q3: "Is the repo private,\nsensitive, or tied to my homelab?"

q4: "Does the task involve\nmultiple repos or my local network?"

q5: "Is it a small, one-off\nGitHub task on a public repo?"

q6: "Do I need refactoring\nwith code changes,\ntests, commits, or PR creation?"

q7: "Is it an automated PR\nwell-integrated with GitHub CI/logs?"

q8: "Do I want to avoid\nany local installation or maintenance?"

q9: "Do I want to run\nCopilot on my homelab?"

script_homelab: {
  label: "Homelab script + occasional Claude"
  shape: rectangle
  style.fill: "#E8F5E9"
}

claude_local: {
  label: "Claude Code CLI on homelab"
  shape: rectangle
  style.fill: "#C8E6C9"
}

copilot_github: {
  label: "GitHub Copilot Agent\nfrom GitHub"
  shape: rectangle
  style.fill: "#E3F2FD"
}

claude_actions: {
  label: "Claude Code via\nGitHub Actions"
  shape: rectangle
  style.fill: "#FFF3E0"
}

copilot_self_hosted: {
  label: "Copilot Agent on homelab\n/ self-hosted runner"
  shape: rectangle
  style.fill: "#FCE4EC"
}

avoid: {
  label: "Avoid initially\nunless advanced need"
  shape: rectangle
  style.fill: "#FFEBEE"
}

why_script: {
  label: "Why?\n- git log / git diff\n- commit summary\n- daily email\n- text report\n- cron / systemd timer\n- minimal cost\n- no code modification"
  shape: rectangle
  style.stroke-dash: 4
  style.fill: "#F1F8E9"
}

why_local: {
  label: "Why?\n- private or sensitive repos\n- real refactoring\n- code modification\n- tests / commits / PR\n- multi-repo\n- local network / homelab access\n- nightly orchestration\n- secrets kept out of GitHub"
  shape: rectangle
  style.stroke-dash: 4
  style.fill: "#F1F8E9"
}

why_copilot: {
  label: "Why?\n- simple, integrated with GitHub\n- ideal for small PRs / reviews\n- public repo, low volume\n- zero homelab maintenance\n! Copilot Pro: 300 requests/month\n! consumes requests + Actions minutes"
  shape: rectangle
  style.stroke-dash: 4
  style.fill: "#EAF4FF"
}

why_actions: {
  label: "Why?\n- automated PRs\n- GitHub checks\n- Actions logs\n- triggers: push, PR, issue, cron, dispatch\n- good GitHub + Claude compromise"
  shape: rectangle
  style.stroke-dash: 4
  style.fill: "#FFF8E1"
}

why_self_hosted: {
  label: "Why rarely?\n- high complexity\n- geared toward GitHub organizations\n- ephemeral runners recommended\n- Ubuntu x64 / Windows only\n- Pro quota still capped (300 req/month)\n- poor return for personal use"
  shape: rectangle
  style.stroke-dash: 4
  style.fill: "#FCE4EC"
}

legend: {
  label: "Choice rule\n\nSimple, one-off, public GitHub task:\n  → Copilot Agent (GitHub)\nPrivate / multi-repo / local network / email:\n  → Claude Code CLI homelab\nAutomated PR with GitHub CI/logs:\n  → Claude Code GitHub Actions\nEmail / report / summary without code:\n  → Homelab script + Claude\nSelf-hosted Copilot:\n  → organizations only, advanced need"
  shape: rectangle
  style.stroke-dash: 4
  style.fill: "#F5F5F5"
}

cost_warning: {
  label: "Cost snapshot (May 2026)\n\nCopilot Pro 10 USD/month → 300 premium requests, +0.04 USD/req beyond that\nCopilot Pro+ 39 USD/month → 1,500 premium requests\nClaude Code Pro ≈20 USD/month → limits shared with Claude.ai\nClaude Code Max ≈100 USD/month → 5x or 20x higher quota\nPublic Actions: free — Private Actions: ≈0.006 USD/min (Linux)"
  shape: rectangle
  style.stroke-dash: 4
  style.fill: "#ECEFF1"
}

start -> q1

q1 -> q2: "Yes"
q1 -> q3: "No"

q2 -> script_homelab: "Yes"
script_homelab -> why_script

q2 -> claude_local: "No,\nneeds heavy modification or exploration"
claude_local -> why_local

q3 -> claude_local: "Yes"
q3 -> q4: "No"

q4 -> claude_local: "Yes"
q4 -> q5: "No"

q5 -> copilot_github: "Yes"
copilot_github -> why_copilot

q5 -> q6: "No"

q6 -> claude_local: "Yes,\nand needs local control"
q6 -> q7: "Yes,\nand I want GitHub-native"

q6 -> q8: "No"

q7 -> claude_actions: "Yes"
claude_actions -> why_actions

q7 -> claude_local: "No,\nI prefer to control it locally"

q8 -> copilot_github: "Yes"
q8 -> q9: "No"

q9 -> copilot_self_hosted: "Yes"
copilot_self_hosted -> avoid
copilot_self_hosted -> why_self_hosted

q9 -> claude_local: "No"

script_homelab -> legend
claude_local -> legend
copilot_github -> legend
claude_actions -> legend

legend -> cost_warning
